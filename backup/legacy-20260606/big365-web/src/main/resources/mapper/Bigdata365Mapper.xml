<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.mlj.share.big365.example.mapper.Bigdata365Mapper">
    <select id="findOne" parameterType="Integer" resultType="java.util.Map">
        SELECT * FROM `bigdata_365` WHERE pid = #{id}
    </select>

    <select id="list" resultType="java.util.Map">
        SELECT * FROM `bigdata_365` LIMIT 10
    </select>
</mapper>
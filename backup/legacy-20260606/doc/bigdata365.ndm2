            "DDL": "CREATE TABLE `bigdata_test_r2c_simple_365` (\n  `pid` int unsigned NOT NULL,\n  `a` tinyint unsigned NOT NULL COMMENT '0-10',\n  `b` tinyint unsigned NOT NULL COMMENT '0-100',\n  `c` mediumint unsigned NOT NULL COMMENT '0-100000',\n  PRIMARY KEY (`a`,`b`,`c`) USING BTREE,\n  KEY `idx_pid` (`pid`),\n  KEY `idx_bc` (`b`,`c`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci\n/*!50500 PARTITION BY RANGE  COLUMNS(a,b,c)\n(PARTITION p1 VALUES LESS THAN (1,10,10000) ENGINE = InnoDB,\n PARTITION p2 VALUES LESS THAN (2,20,20000) ENGINE = InnoDB,\n PARTITION p3 VALUES LESS THAN (3,30,30000) ENGINE = InnoDB,\n PARTITION p4 VALUES LESS THAN (4,40,40000) ENGINE = InnoDB,\n PARTITION p5 VALUES LESS THAN (5,50,50000) ENGINE = InnoDB,\n PARTITION p6 VALUES LESS THAN (6,60,60000) ENGINE = InnoDB,\n PARTITION p7 VALUES LESS THAN (7,70,70000) ENGINE = InnoDB,\n PARTITION p8 VALUES LESS THAN (8,80,80000) ENGINE = InnoDB,\n PARTITION p9 VALUES LESS THAN (9,90,90000) ENGINE = InnoDB,\n PARTITION p10 VALUES LESS THAN (MAXVALUE,MAXVALUE,MAXVALUE) ENGINE = InnoDB) */",

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.big365.api.demo.DemoJobMapper">

    <resultMap id="DemoJobResult" type="org.big365.api.demo.DemoGenerationJob">
        <id property="id" column="id"/>
        <result property="jobId" column="job_id"/>
        <result property="scale" column="scale"/>
        <result property="status" column="status"/>
        <result property="progress" column="progress"/>
        <result property="totalRows" column="total_rows"/>
        <result property="summary" column="summary"/>
        <result property="errorMessage" column="error_message"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <insert id="insert">
        INSERT INTO `${tableName}` (`job_id`, `scale`, `status`, `progress`)
        VALUES (#{job.jobId}, #{job.scale}, #{job.status}, #{job.progress})
    </insert>

    <select id="findByJobId" resultMap="DemoJobResult">
        SELECT `id`, `job_id`, `scale`, `status`, `progress`,
               `total_rows`, `summary`, `error_message`, `created_at`, `updated_at`
        FROM `${tableName}`
        WHERE `job_id` = #{jobId}
        LIMIT 1
    </select>

    <update id="updateStatus">
        UPDATE `${tableName}`
        SET `status` = #{status},
            `progress` = #{progress}
            <if test="errorMessage != null and errorMessage != ''">
                , `error_message` = #{errorMessage}
            </if>
        WHERE `job_id` = #{jobId}
    </update>

    <update id="complete">
        UPDATE `${tableName}`
        SET `status` = 'completed',
            `progress` = 100,
            `total_rows` = #{totalRows},
            `summary` = #{summary}
        WHERE `job_id` = #{jobId}
    </update>

</mapper>
